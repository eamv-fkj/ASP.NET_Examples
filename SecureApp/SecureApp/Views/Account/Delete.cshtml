@model AppUser

@{
  ViewData["Title"] = "Slet account";
}

<div class="container mt-4">
  <h1>Slet account</h1>
  <p class="text-danger">Er du sikker på, at du vil slette denne account?</p>

  <dl class="row">
    <dt class="col-sm-3">Fornavn</dt>
    <dd class="col-sm-9">@Model.FirstName</dd>

    <dt class="col-sm-3">Efternavn</dt>
    <dd class="col-sm-9">@Model.LastName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
  </dl>

  <form asp-action="Delete" method="post" class="mt-3">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />
    
    <button type="submit" class="btn btn-danger">Slet</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Annuller</a>
  </form>
</div>
