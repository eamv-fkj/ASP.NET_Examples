@model IEnumerable<Order>

@{
  ViewData["Title"] = "Mine ordrer";
}

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Mine ordrer</h1>
    <div class="d-flex gap-2">
      <a asp-action="Create" class="btn btn-primary">Ny ordre</a>
      <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="btn btn-outline-secondary">Log ud</button>
      </form>
    </div>
  </div>

  @if (TempData["Success"] is string success) {
    <div class="alert alert-success">@success</div>
  }

  @if (!Model.Any()) {
    <p class="text-muted">Ingen ordrer fundet.</p>
  } else {
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th>Produkt</th>
          <th>Antal</th>
          <th>Ordredato</th>
          <th class="text-end">Kommandoer</th>
        </tr>
      </thead>
      <tbody>
        @foreach (Order order in Model) {
          <tr>
            <td>@order.ProductName</td>
            <td>@order.Quantity</td>
            <td>@order.OrderDate.ToString("dd-MM-yyyy HH:mm")</td>
            <td class="text-end">
              <div class="btn-group btn-group-sm" role="group">
                <a asp-action="Details" asp-route-id="@order.Id"
                  class="btn btn-outline-secondary">Show details</a>
                <a asp-action="Edit" asp-route-id="@order.Id"
                  class="btn btn-outline-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@order.Id"
                  class="btn btn-outline-danger">Delete</a>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>
