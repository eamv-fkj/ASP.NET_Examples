@model Order

@{
  ViewData["Title"] = "Ordre detaljer";
}

<div class="container mt-4">
  <h1>Ordre detaljer</h1>

  <dl class="row mt-3">
    <dt class="col-sm-3">Produkt</dt>
    <dd class="col-sm-9">@Model.ProductName</dd>

    <dt class="col-sm-3">Antal</dt>
    <dd class="col-sm-9">@Model.Quantity</dd>

    <dt class="col-sm-3">Ordredato</dt>
    <dd class="col-sm-9">@Model.OrderDate.ToString("dd-MM-yyyy HH:mm")</dd>
  </dl>

  <div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Tilbage</a>
  </div>
</div>
