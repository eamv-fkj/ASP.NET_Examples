@page
@model IndexModel

@{
  ViewData["Title"] = "Produktliste";
}

<div class="container py-4">
  <h2 class="mb-3">Produktliste</h2>

  @if (TempData["Success"] is string message) {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      @message
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Luk"></button>
    </div>
  }

  <p>
    <a asp-page="Create" class="btn btn-primary">Opret nyt produkt</a>
  </p>

  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>Navn</th>
        <th>Kommando</th>
      </tr>
    </thead>
    <tbody>
      @foreach (Product product in Model.Products) {
        <tr>
          <td>@product.Name</td>
          <td>
            <a asp-page="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Detaljer</a>
            <a asp-page="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-warning">Rediger</a>
            <a asp-page="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Slet</a>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>
