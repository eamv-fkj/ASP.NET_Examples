@page "{id:int}"
@model DetailsModel

@{
  ViewData["Title"] = "Produktdetaljer";
}

<div class="container py-4">
  <h2 class="mb-3">Produktdetaljer</h2>
  <hr />

  <dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Product?.Id</dd>

    <dt class="col-sm-2">Navn</dt>
    <dd class="col-sm-10">@Model.Product?.Name</dd>
  </dl>

  <a asp-page="Edit" asp-route-id="@Model.Product?.Id" class="btn btn-warning">Rediger</a>
  <a asp-page="Index" class="btn btn-secondary">Tilbage til listen</a>
</div>
