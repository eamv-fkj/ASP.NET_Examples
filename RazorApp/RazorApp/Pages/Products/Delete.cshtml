@page "{id:int}"
@model DeleteModel

@{
  ViewData["Title"] = "Slet produkt";
}

<div class="container py-4">
  <h2 class="mb-3">Slet produkt</h2>

  <h3 class="text-danger">Er du sikker på, at du vil slette dette produkt?</h3>
  <hr />

  <dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Product?.Id</dd>

    <dt class="col-sm-2">Navn</dt>
    <dd class="col-sm-10">@Model.Product?.Name</dd>
  </dl>

  <form method="post">
    <button type="submit" class="btn btn-danger">Slet</button>
    <a asp-page="Index" class="btn btn-secondary">Fortryd</a>
  </form>
</div>
