@model OrderCreateViewModel

@{
  ViewData["Title"] = "Ny ordre";
}

<div class="container mt-4">
  <h1>Ny ordre</h1>

  <div class="row">
    <div class="col-md-6">
      <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
          <label for="ProductName" class="form-label">Produktnavn</label>
          <input asp-for="ProductName" class="form-control" />
          <span asp-validation-for="ProductName" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label for="Quantity" class="form-label">Antal</label>
          <input asp-for="Quantity" type="number" step="1" class="form-control" />
          <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Opret</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Annuller</a>
      </form>
    </div>
  </div>
</div>
