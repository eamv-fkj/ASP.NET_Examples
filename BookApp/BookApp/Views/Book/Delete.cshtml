@model Book

@{
  ViewData["Title"] = "Slet bog";
}

<h1>Slet bog</h1>

<h3 class="text-danger">Er du sikker på, at du vil slette denne bog?</h3>
<hr />

<div>
  <dl class="row">
    <dt class="col-sm-2">Titel</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Forfatter</dt>
    <dd class="col-sm-10">@Model.Author</dd>

    <dt class="col-sm-2">Sidetal</dt>
    <dd class="col-sm-10">@Model.Pages</dd>

    <dt class="col-sm-2">Pris</dt>
    <dd class="col-sm-10">@Model.Price.ToString("N2")</dd>

    <dt class="col-sm-2">Udgivelsesår</dt>
    <dd class="col-sm-10">@Model.Published</dd>
  </dl>

  <form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Slet</button>
    <a asp-action="Index" class="btn btn-secondary">Annullér</a>
  </form>
</div>