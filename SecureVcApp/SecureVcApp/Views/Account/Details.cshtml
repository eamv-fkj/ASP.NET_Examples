@model AppUser

@{
  ViewData["Title"] = "Account detaljer";
}

<div class="container mt-4">
  <h1>Account detaljer</h1>

  <dl class="row mt-3">
    <dt class="col-sm-3">Fornavn</dt>
    <dd class="col-sm-9">@Model.FirstName</dd>

    <dt class="col-sm-3">Efternavn</dt>
    <dd class="col-sm-9">@Model.LastName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Brugernavn</dt>
    <dd class="col-sm-9">@Model.UserName</dd>
  </dl>

  <div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Tilbage</a>
  </div>
</div>
