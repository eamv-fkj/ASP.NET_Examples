@model Order

@{
  ViewData["Title"] = "Slet ordre";
}

<div class="container mt-4">
  <h1>Slet ordre</h1>
  <p class="text-danger">Er du sikker på, at du vil slette denne ordre?</p>

  <dl class="row">
    <dt class="col-sm-3">Produkt</dt>
    <dd class="col-sm-9">@Model.ProductName</dd>

    <dt class="col-sm-3">Antal</dt>
    <dd class="col-sm-9">@Model.Quantity</dd>

    <dt class="col-sm-3">Ordredato</dt>
    <dd class="col-sm-9">@Model.OrderDate.ToString("dd-MM-yyyy HH:mm")</dd>
  </dl>

  <form asp-action="Delete" method="post" class="mt-3">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Slet</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Annuller</a>
  </form>
</div>
