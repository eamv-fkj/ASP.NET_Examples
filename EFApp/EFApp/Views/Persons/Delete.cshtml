@model EFApp.Models.Person

@{
  ViewData["Title"] = "Slet person";
}

<div class="container mt-4">
  <h1>Slet person</h1>
  <p class="text-danger">Er du sikker på, at du vil slette denne person?</p>

  <dl class="row">
    <dt class="col-sm-3">Navn</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Alder</dt>
    <dd class="col-sm-9">@Model.Age</dd>

    <dt class="col-sm-3">By</dt>
    <dd class="col-sm-9">@Model.City</dd>
  </dl>

  <form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Slet</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Annuller</a>
  </form>
</div>
