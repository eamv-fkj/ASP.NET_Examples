@model IEnumerable<Person>

@{
  ViewData["Title"] = "Personer";
}

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Personer</h1>
    <a asp-action="Create" class="btn btn-primary">Ny person</a>
  </div>

  @if (!Model.Any()) {
    <p class="text-muted">Ingen personer fundet.</p>
  }
  else {
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th>Navn</th>
          <th>Alder</th>
          <th>By</th>
          <th class="text-end">Kommandoer</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var person in Model) {
          <tr>
            <td>@person.Name</td>
            <td>@person.Age</td>
            <td>@person.City</td>
            <td class="text-end">
              <div class="btn-group btn-group-sm" role="group">
                <a asp-action="Details" asp-route-id="@person.Id" class="btn btn-outline-secondary">Show details</a>
                <a asp-action="Edit" asp-route-id="@person.Id" class="btn btn-outline-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@person.Id" class="btn btn-outline-danger">Delete</a>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>
