@model EFApp.Models.Person

@{
  ViewData["Title"] = "Detaljer";
}

<div class="container mt-4">
  <h1>Detaljer</h1>

  <dl class="row mt-3">
    <dt class="col-sm-3">Navn</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Alder</dt>
    <dd class="col-sm-9">@Model.Age</dd>

    <dt class="col-sm-3">By</dt>
    <dd class="col-sm-9">@Model.City</dd>
  </dl>

  <div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Tilbage</a>
  </div>
</div>
