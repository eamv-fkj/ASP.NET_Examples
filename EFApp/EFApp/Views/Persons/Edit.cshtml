@model EFApp.Models.Person

@{
  ViewData["Title"] = "Rediger person";
}

<div class="container mt-4">
  <h1>Rediger person</h1>

  <div class="row">
    <div class="col-md-6">
      <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
          <label for="Name" class="form-label">Navn</label>
          <input asp-for="Name" class="form-control" />
          <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label for="Age" class="form-label">Alder</label>
          <input asp-for="Age" class="form-control" />
          <span asp-validation-for="Age" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label for="City" class="form-label">By</label>
          <input asp-for="City" class="form-control" />
          <span asp-validation-for="City" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Gem</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Annuller</a>
      </form>
    </div>
  </div>
</div>
